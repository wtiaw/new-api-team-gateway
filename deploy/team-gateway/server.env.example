# Copy to .env in your server deployment directory; chmod 600 .env.
# Build this image from the fork; it is not an upstream image tag.
NEW_API_IMAGE=new-api-team-gateway:team-v0.1.0
GATEWAY_PORT=18310
SITE_URL=https://gateway.example.com
SESSION_COOKIE_TRUSTED_URL=https://gateway.example.com
# Replace with the actual reverse proxy address or tightly scoped network.
TRUSTED_PROXIES=172.30.0.10/32
CADDY_NETWORK=gateway-edge
# Generate each independently, e.g. openssl rand -hex 32. Do not commit .env.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
